{
 "module": "academico",
 "pages": {
  "/academico/matriculas": {
   "title": "Matrículas",
   "icon": "fa-user-graduate",
   "currency": "BRL",
   "entity": {
    "singular": "Matrícula",
    "plural": "Matrículas",
    "icon": "fa-id-card",
    "newLabel": "Nova matrícula"
   },
   "banner": {
    "icon": "fa-user-graduate",
    "title": "Matrículas 2026",
    "desc": "Pré-matrículas, documentação pendente, análise e alunos matriculados por curso.",
    "pill": "{count} matrículas",
    "attention": {
     "agg": "count",
     "where": {
      "status": "rejected"
     }
    }
   },
   "titleField": "student",
   "codeField": "code",
   "subField": "course",
   "statusField": "status",
   "stageField": "status",
   "count": 48,
   "fields": [
    {
     "key": "student",
     "label": "Aluno",
     "type": "person"
    },
    {
     "key": "course",
     "label": "Curso",
     "type": "enum",
     "values": [
      {
       "id": "EM",
       "label": "Ensino Médio",
       "tone": "blue",
       "weight": 4
      },
      {
       "id": "EF2",
       "label": "Fundamental II",
       "tone": "emerald",
       "weight": 3
      },
      {
       "id": "TEC-INF",
       "label": "Técnico em Informática",
       "tone": "purple",
       "weight": 2
      },
      {
       "id": "TEC-ENF",
       "label": "Técnico em Enfermagem",
       "tone": "amber",
       "weight": 2
      }
     ]
    },
    {
     "key": "code",
     "label": "Matrícula",
     "type": "code",
     "prefix": "MAT"
    },
    {
     "key": "status",
     "label": "Status",
     "type": "status"
    },
    {
     "key": "shift",
     "label": "Turno",
     "type": "enum",
     "values": [
      {
       "id": "morning",
       "label": "Manhã",
       "tone": "amber",
       "weight": 4
      },
      {
       "id": "afternoon",
       "label": "Tarde",
       "tone": "blue",
       "weight": 3
      },
      {
       "id": "night",
       "label": "Noite",
       "tone": "purple",
       "weight": 2
      }
     ]
    },
    {
     "key": "tuition",
     "label": "Mensalidade",
     "type": "money",
     "min": 680,
     "max": 2400
    },
    {
     "key": "attendance",
     "label": "Frequência",
     "type": "pct",
     "min": 62,
     "max": 100
    },
    {
     "key": "enrollment_date",
     "label": "Data da matrícula",
     "type": "date",
     "from": -240,
     "to": -1
    },
    {
     "key": "guardian",
     "label": "Responsável",
     "type": "person",
     "table": false
    },
    {
     "key": "email",
     "label": "E-mail",
     "type": "email",
     "table": false
    },
    {
     "key": "scholarship",
     "label": "Bolsista",
     "type": "bool",
     "p": 0.2,
     "table": false
    }
   ],
   "statuses": [
    {
     "id": "pre_enrollment",
     "label": "Pré-matrícula",
     "tone": "slate",
     "weight": 2
    },
    {
     "id": "documents",
     "label": "Documentação",
     "tone": "blue",
     "weight": 2
    },
    {
     "id": "review",
     "label": "Em análise",
     "tone": "amber",
     "weight": 2
    },
    {
     "id": "active",
     "label": "Matriculado",
     "tone": "emerald",
     "weight": 6
    },
    {
     "id": "rejected",
     "label": "Indeferido",
     "tone": "rose",
     "weight": 1
    }
   ],
   "stages": [
    {
     "id": "pre_enrollment",
     "label": "Pré-matrícula",
     "tone": "slate",
     "weight": 2
    },
    {
     "id": "documents",
     "label": "Documentação",
     "tone": "blue",
     "weight": 2
    },
    {
     "id": "review",
     "label": "Em análise",
     "tone": "amber",
     "weight": 2
    },
    {
     "id": "active",
     "label": "Matriculado",
     "tone": "emerald",
     "weight": 6
    },
    {
     "id": "rejected",
     "label": "Indeferido",
     "tone": "rose",
     "weight": 1
    }
   ],
   "kpis": [
    {
     "label": "Matrículas ativas",
     "sub": "Ano letivo 2026",
     "icon": "fa-user-graduate",
     "tone": "emerald",
     "value": {
      "agg": "count",
      "where": {
       "status": "active"
      }
     },
     "unitLabel": "Alunos",
     "chips": [
      {
       "label": "Em análise",
       "tone": "amber",
       "value": {
        "agg": "count",
        "where": {
         "status": "review"
        }
       }
      },
      {
       "label": "Documentação",
       "tone": "blue",
       "value": {
        "agg": "count",
        "where": {
         "status": "documents"
        }
       }
      }
     ],
     "formula": "COUNT(enrollments WHERE status = 'active' AND deleted_at IS NULL)"
    },
    {
     "label": "Receita mensal",
     "sub": "Mensalidades ativas",
     "icon": "fa-sack-dollar",
     "tone": "blue",
     "value": {
      "agg": "sum",
      "field": "tuition",
      "where": {
       "status": "active"
      }
     },
     "unit": "money",
     "pill": "Mensal",
     "footer": [
      {
       "label": "Ticket médio",
       "value": {
        "agg": "avg",
        "field": "tuition",
        "where": {
         "status": "active"
        }
       },
       "unit": "money"
      }
     ],
     "formula": "SUM(academic_billing_rules.monthly_tuition) das matrículas ativas"
    },
    {
     "label": "Frequência média",
     "sub": "Últimos 30 dias",
     "icon": "fa-calendar-check",
     "tone": "amber",
     "value": {
      "agg": "avg",
      "field": "attendance"
     },
     "unit": "%",
     "footer": [
      {
       "label": "Menor frequência",
       "value": {
        "agg": "min",
        "field": "attendance"
       },
       "unit": "%"
      }
     ],
     "formula": "AVG(presenças / aulas) em attendance"
    },
    {
     "label": "Indeferidas",
     "sub": "Exigem contato",
     "icon": "fa-triangle-exclamation",
     "tone": "rose",
     "value": {
      "agg": "count",
      "where": {
       "status": "rejected"
      }
     },
     "unitLabel": "Solicitações",
     "formula": "status = 'rejected'"
    }
   ],
   "breakdown": {
    "by": "course",
    "title": "Matrículas por curso",
    "desc": "Distribuição atual",
    "icon": "fa-layer-group",
    "attention": {
     "where": {
      "status": "rejected"
     },
     "badge": "status",
     "title": "Indeferidas",
     "desc": "Contatar o responsável",
     "empty": "Nenhuma matrícula indeferida."
    }
   },
   "cardFields": [
    "tuition",
    "attendance",
    "enrollment_date"
   ],
   "cardLine": "shift",
   "kanbanTitle": "Funil de matrícula",
   "kanbanDesc": "Pré-matrícula → documentação → análise → matriculado",
   "kanbanValue": "tuition",
   "kanbanDate": "enrollment_date",
   "drawer": {
    "metrics": [
     "tuition",
     "attendance",
     "enrollment_date",
     "shift"
    ],
    "sections": [
     {
      "title": "Aluno e responsável",
      "icon": "fa-user",
      "fields": [
       "student",
       "guardian",
       "email",
       "scholarship"
      ]
     },
     {
      "title": "Matrícula",
      "icon": "fa-id-card",
      "fields": [
       "course",
       "shift",
       "status"
      ]
     }
    ]
   },
   "form": [
    "student",
    "guardian",
    "email",
    "course",
    "shift",
    "tuition",
    "enrollment_date",
    "scholarship"
   ],
   "analytics": [
    {
     "title": "Matrículas por curso",
     "desc": "Situação atual",
     "by": "course",
     "type": "bar",
     "measure": {
      "agg": "count",
      "unit": "count"
     }
    },
    {
     "title": "Matrículas por status",
     "desc": "Funil",
     "by": "status",
     "type": "doughnut",
     "measure": {
      "agg": "count",
      "unit": "count"
     }
    },
    {
     "title": "Novas matrículas por mês",
     "desc": "Pela data da matrícula",
     "by": "month",
     "type": "line",
     "measure": {
      "agg": "count",
      "unit": "count"
     },
     "date": "enrollment_date",
     "wide": true
    }
   ],
   "endpoints": {
    "create": "POST /api/v1/domain/records/academic/enrollment/re-enrollment",
    "edit": "PUT /api/v1/domain/records/academic/enrollment/re-enrollment/{id}",
    "delete": "DELETE /api/v1/domain/records/academic/enrollment/re-enrollment/{id}",
